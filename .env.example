# Copy this file to .env.local and fill in the values.
# See docs/GOOGLE-SHEETS-SETUP.md for where each value comes from.

# The web app URL from Apps Script → Deploy (ends in /exec)
SHEETS_WEBAPP_URL=

# The secret printed by running `setup` in Apps Script
SHEETS_SECRET=

# A passcode you choose. You'll type it once in the app (Settings → Google Sheets sync).
# Strongly recommended before putting the app online.
APP_PASSCODE=
