# Copy this file to .env.local and fill in the values.
# See docs/GOOGLE-SHEETS-SETUP.md for where each value comes from.

# The web app URL from Apps Script → Deploy (ends in /exec)
SHEETS_WEBAPP_URL=

# The secret printed by running `setup` in Apps Script
SHEETS_SECRET=

# A passcode you choose. You'll type it once on each device to unlock the app.
APP_PASSCODE=

# Phone notifications (Web Push). Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
